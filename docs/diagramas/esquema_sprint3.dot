digraph G {graph [rankdir=TB,bgcolor="white",nodesep=.35,ranksep=.65,pad=.2]; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=.7,constraint=false];"profiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>profiles</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="dni" ALIGN="LEFT"><FONT POINT-SIZE="10">dni</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">varchar</FONT></TD></TR></TABLE>>];"participants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>participants</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="profile_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK profile_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="dni" ALIGN="LEFT"><FONT POINT-SIZE="10">dni</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR></TABLE>>];"enrollments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>enrollments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="training_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK training_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="participant_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK participant_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enum</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"certificates" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>certificates</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="enrollment_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK enrollment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="certificate_number" ALIGN="LEFT"><FONT POINT-SIZE="10">certificate_number</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="issued_at" ALIGN="LEFT"><FONT POINT-SIZE="10">issued_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">timestamptz</FONT></TD></TR><TR><TD PORT="issued_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK issued_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"system_settings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>system_settings</B></FONT></TD></TR><TR><TD PORT="value" ALIGN="LEFT"><FONT POINT-SIZE="10">value</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">jsonb</FONT></TD></TR><TR><TD PORT="updated_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK updated_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"audit_logs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK actor_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="action" ALIGN="LEFT"><FONT POINT-SIZE="10">action</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR></TABLE>>];"participants":"profile_id" -> "profiles":"id";"enrollments":"participant_id" -> "participants":"id";"enrollments":"reviewed_by" -> "profiles":"id";"certificates":"enrollment_id" -> "enrollments":"id";"certificates":"issued_by" -> "profiles":"id";"system_settings":"updated_by" -> "profiles":"id";"audit_logs":"actor_id" -> "profiles":"id";{rank=same; "profiles";"participants";}"profiles" -> "enrollments" [style=invis,constraint=true];{rank=same; "enrollments";"certificates";}"enrollments" -> "system_settings" [style=invis,constraint=true];{rank=same; "system_settings";"audit_logs";}}