digraph G {graph [rankdir=TB,bgcolor="white",nodesep=.35,ranksep=.65,pad=.2]; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=.7,constraint=false];"api_rate_limits" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>api_rate_limits</B></FONT></TD></TR></TABLE>>];"attendance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>attendance</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="session_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK session_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="enrollment_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK enrollment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK recorded_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"audit_logs" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>audit_logs</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">bigint</FONT></TD></TR><TR><TD PORT="actor_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK actor_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"certificates" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>certificates</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="enrollment_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK enrollment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="issued_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK issued_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"enrollment_attendance_summary" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>enrollment_attendance_summary</B></FONT></TD></TR></TABLE>>];"enrollments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>enrollments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="training_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK training_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="participant_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK participant_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"management_indicators" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>management_indicators</B></FONT></TD></TR></TABLE>>];"membership_payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>membership_payments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="membership_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK membership_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"memberships" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>memberships</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="profile_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK profile_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"participants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>participants</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="profile_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK profile_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"profiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>profiles</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"system_settings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>system_settings</B></FONT></TD></TR><TR><TD PORT="updated_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK updated_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"training_payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>training_payments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="enrollment_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK enrollment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"training_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>training_sessions</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="training_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK training_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"trainings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>trainings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK created_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"trainings":"created_by" -> "profiles":"id";"training_sessions":"training_id" -> "trainings":"id";"participants":"profile_id" -> "profiles":"id";"enrollments":"training_id" -> "trainings":"id";"enrollments":"participant_id" -> "participants":"id";"enrollments":"reviewed_by" -> "profiles":"id";"training_payments":"enrollment_id" -> "enrollments":"id";"training_payments":"reviewed_by" -> "profiles":"id";"attendance":"session_id" -> "training_sessions":"id";"attendance":"enrollment_id" -> "enrollments":"id";"attendance":"recorded_by" -> "profiles":"id";"memberships":"profile_id" -> "profiles":"id";"membership_payments":"membership_id" -> "memberships":"id";"membership_payments":"reviewed_by" -> "profiles":"id";"certificates":"enrollment_id" -> "enrollments":"id";"certificates":"issued_by" -> "profiles":"id";"system_settings":"updated_by" -> "profiles":"id";"audit_logs":"actor_id" -> "profiles":"id";{rank=same; "api_rate_limits";"attendance";"audit_logs";}"api_rate_limits" -> "certificates" [style=invis,constraint=true];{rank=same; "certificates";"enrollment_attendance_summary";"enrollments";}"certificates" -> "management_indicators" [style=invis,constraint=true];{rank=same; "management_indicators";"membership_payments";"memberships";}"management_indicators" -> "participants" [style=invis,constraint=true];{rank=same; "participants";"profiles";"system_settings";}"participants" -> "training_payments" [style=invis,constraint=true];{rank=same; "training_payments";"training_sessions";"trainings";}}