digraph G {graph [rankdir=TB,bgcolor="white",nodesep=.35,ranksep=.65,pad=.2]; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=.7,constraint=false];"profiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>profiles</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="dni" ALIGN="LEFT"><FONT POINT-SIZE="10">dni</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">varchar</FONT></TD></TR></TABLE>>];"trainings" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>trainings</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="title" ALIGN="LEFT"><FONT POINT-SIZE="10">title</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enum</FONT></TD></TR><TR><TD PORT="created_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK created_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"training_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>training_sessions</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="training_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK training_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="title" ALIGN="LEFT"><FONT POINT-SIZE="10">title</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="starts_at" ALIGN="LEFT"><FONT POINT-SIZE="10">starts_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">timestamptz</FONT></TD></TR></TABLE>>];"participants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>participants</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="profile_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK profile_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="dni" ALIGN="LEFT"><FONT POINT-SIZE="10">dni</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR></TABLE>>];"enrollments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>enrollments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="training_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK training_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="participant_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK participant_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enum</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"training_payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>training_payments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="enrollment_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK enrollment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="10">amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">numeric</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enum</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"trainings":"created_by" -> "profiles":"id";"training_sessions":"training_id" -> "trainings":"id";"participants":"profile_id" -> "profiles":"id";"enrollments":"training_id" -> "trainings":"id";"enrollments":"participant_id" -> "participants":"id";"enrollments":"reviewed_by" -> "profiles":"id";"training_payments":"enrollment_id" -> "enrollments":"id";"training_payments":"reviewed_by" -> "profiles":"id";{rank=same; "profiles";"trainings";}"profiles" -> "training_sessions" [style=invis,constraint=true];{rank=same; "training_sessions";"participants";}"training_sessions" -> "enrollments" [style=invis,constraint=true];{rank=same; "enrollments";"training_payments";}}