digraph G {graph [rankdir=TB,bgcolor="white",nodesep=.35,ranksep=.65,pad=.2]; node [shape=plain,fontname="Helvetica"]; edge [color="#64748b",arrowsize=.7,constraint=false];"profiles" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>profiles</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="dni" ALIGN="LEFT"><FONT POINT-SIZE="10">dni</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">varchar</FONT></TD></TR></TABLE>>];"participants" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>participants</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="profile_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK profile_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="full_name" ALIGN="LEFT"><FONT POINT-SIZE="10">full_name</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="dni" ALIGN="LEFT"><FONT POINT-SIZE="10">dni</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">varchar</FONT></TD></TR><TR><TD PORT="email" ALIGN="LEFT"><FONT POINT-SIZE="10">email</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR></TABLE>>];"memberships" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>memberships</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="profile_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK profile_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enum</FONT></TD></TR></TABLE>>];"membership_payments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>membership_payments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="membership_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK membership_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="amount" ALIGN="LEFT"><FONT POINT-SIZE="10">amount</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">numeric</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enum</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"enrollments" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>enrollments</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="training_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK training_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="participant_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK participant_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">enum</FONT></TD></TR><TR><TD PORT="reviewed_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK reviewed_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"training_sessions" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>training_sessions</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="training_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK training_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="title" ALIGN="LEFT"><FONT POINT-SIZE="10">title</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="starts_at" ALIGN="LEFT"><FONT POINT-SIZE="10">starts_at</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">timestamptz</FONT></TD></TR></TABLE>>];"attendance" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#b5c5ce"><TR><TD COLSPAN="2" BGCOLOR="#18576b"><FONT COLOR="white"><B>attendance</B></FONT></TD></TR><TR><TD PORT="id" ALIGN="LEFT"><FONT POINT-SIZE="10">PK id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="session_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK session_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="enrollment_id" ALIGN="LEFT"><FONT POINT-SIZE="10">FK enrollment_id</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR><TR><TD PORT="status" ALIGN="LEFT"><FONT POINT-SIZE="10">status</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">text</FONT></TD></TR><TR><TD PORT="recorded_by" ALIGN="LEFT"><FONT POINT-SIZE="10">FK recorded_by</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="9">uuid</FONT></TD></TR></TABLE>>];"participants":"profile_id" -> "profiles":"id";"enrollments":"participant_id" -> "participants":"id";"enrollments":"reviewed_by" -> "profiles":"id";"attendance":"session_id" -> "training_sessions":"id";"attendance":"enrollment_id" -> "enrollments":"id";"attendance":"recorded_by" -> "profiles":"id";"memberships":"profile_id" -> "profiles":"id";"membership_payments":"membership_id" -> "memberships":"id";"membership_payments":"reviewed_by" -> "profiles":"id";{rank=same; "profiles";"participants";}"profiles" -> "memberships" [style=invis,constraint=true];{rank=same; "memberships";"membership_payments";}"memberships" -> "enrollments" [style=invis,constraint=true];{rank=same; "enrollments";"training_sessions";}"enrollments" -> "attendance" [style=invis,constraint=true];{rank=same; "attendance";}}